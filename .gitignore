# =====================================================================
# Nexa Recruit Monorepo .gitignore
# =====================================================================

# --- Environment Secrets (NEVER COMMIT) ---
.env
.env.*
*.env
**/.env
**/.env.*

# --- Backend Python ---
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd

# --- Testing & Coverage ---
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# --- Private Files & Storage (Resumes, Uploads) ---
backend/private_resumes/
**/private_resumes/
backend/uploads/
uploads/
**/uploads/
*.pdf

# --- Frontend Node & Build ---
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.vite-temp/
**/.vite-temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & OS Cache ---
.vscode/
.idea/
.DS_Store
Thumbs.db
